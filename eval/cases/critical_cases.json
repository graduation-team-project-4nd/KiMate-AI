{
  "suite_id": "critical_cases",
  "description": "Short isolated cases for behaviors that should not regress.",
  "scenarios": [
    {
      "scenario_id": "ambiguous_beef_menu",
      "name": "Ambiguous beef menu must ask clarification",
      "session_id": "eval_critical_001",
      "steps": [
        {
          "step_id": "ask_clarification_for_beef",
          "name": "Ask clarification when multiple beef burgers are visible",
          "severity": "critical",
          "input": {
            "user_input": "소고기 들어간 걸로 줘",
            "ocr_texts": ["버거", "사이드", "음료", "불고기 버거", "치즈버거", "치킨버거"]
          },
          "expected": {
            "status": "ambiguous",
            "action_type": "ask_clarification",
            "candidates_must_include": ["불고기 버거", "치즈버거"],
            "message_should_contain_any": ["어떤", "무엇"]
          },
          "rationale": "사용자가 메뉴를 확정하지 않았으므로 임의 클릭이 아니라 되묻기가 필요하다."
        }
      ]
    },
    {
      "scenario_id": "scroll_instead_of_wrong_click",
      "name": "Off-screen item should lead to scroll guidance",
      "session_id": "eval_critical_002",
      "initial_dialogue_history": [
        {
          "role": "user",
          "utterance": "에그 불고기 버거 주문해 줘"
        },
        {
          "role": "assistant",
          "utterance": "매장 버튼으로 안내하겠습니다.",
          "action": {
            "type": "click_text",
            "params": {
              "target_text": "매장"
            }
          }
        },
        {
          "role": "assistant",
          "utterance": "버거&세트 버튼으로 안내하겠습니다.",
          "action": {
            "type": "click_text",
            "params": {
              "target_text": "버거&세트"
            }
          }
        }
      ],
      "initial_last_btn": "버거&세트",
      "steps": [
        {
          "step_id": "scroll_for_egg_bulgogi",
          "name": "Tell the user to scroll instead of clicking an unrelated visible item",
          "severity": "critical",
          "input": {
            "user_input": null,
            "ocr_texts": ["홈", "전체", "치킨", "씨푸드", "불고기", "추천 메뉴", "버거", "더블 빅맥", "트리플 치즈 버거", "7000원, 675kcal", "5600원, 619kcal", "해피스낵", "사이드", "커피", "빅맥", "더블 불고기 버거", "4600원, 583kcal", "4400원, 636kcal", "디저트", "음료", "해피빈"]
          },
          "expected": {
            "status": ["success", "fail"],
            "action_type": "speak_only",
            "message_should_contain": ["아래", "스크롤"],
            "message_should_not_contain": ["불고기 버튼", "불고기 버튼으로"]
          },
          "rationale": "목표 메뉴가 현재 보이지 않으면 잘못된 클릭보다 스크롤 유도가 안전하다."
        }
      ]
    },
    {
      "scenario_id": "absent_espresso_must_not_click",
      "name": "Missing menu must respond with speak_only",
      "session_id": "eval_critical_003",
      "initial_last_btn": "오렌지 칠리 소스",
      "steps": [
        {
          "step_id": "espresso_absent",
          "name": "Do not click a visible drink when espresso is absent",
          "severity": "critical",
          "input": {
            "user_input": "에스프레소 없어?",
            "ocr_texts": ["세트메뉴 음료를 선택하세요", "코카콜라- 미디엄", "스프라이트- 미디엄", "환타 - 미디엄", "코카콜라 제로 - 미디엄", "아이스 아메리카노 - 미디엄", "아이스 카페 라떼 - 미디엄"]
          },
          "expected": {
            "status": "fail",
            "action_type": "speak_only",
            "message_should_contain": ["에스프레소"],
            "message_should_contain_any": ["없", "다른"]
          },
          "rationale": "화면에 없는 메뉴를 말했을 때는 클릭하지 말고 안내만 해야 한다."
        }
      ]
    },
    {
      "scenario_id": "exact_ocr_text_for_click",
      "name": "Click target must use exact OCR text",
      "session_id": "eval_critical_004",
      "steps": [
        {
          "step_id": "coke_spacing_match",
          "name": "Use the exact visible OCR string for target_text",
          "severity": "critical",
          "input": {
            "user_input": "그럼 코카콜라-미디엄으로 줘",
            "ocr_texts": ["세트메뉴 음료를 선택하세요", "코카콜라- 미디엄", "스프라이트- 미디엄", "환타 - 미디엄", "코카콜라 제로 - 미디엄", "아이스 아메리카노 - 미디엄", "아이스 카페 라떼 - 미디엄"]
          },
          "expected": {
            "status": "success",
            "action_type": "click_text",
            "target_text": "코카콜라- 미디엄",
            "message_should_contain": ["코카콜라"]
          },
          "rationale": "클릭 타깃은 사용자 발화가 아니라 OCR에 실제로 보이는 문자열과 일치해야 한다."
        }
      ]
    }
  ]
}
